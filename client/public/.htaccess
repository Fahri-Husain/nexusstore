<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Jangan tangkap request API (biarkan diteruskan ke Node.js di server/Hostinger)
  RewriteCond %{REQUEST_URI} ^/api [NC]
  RewriteRule .* - [L]

  # SPA fallback: arahkan rute non-file ke index.html
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
